{
  "compilerOptions": {
    "rootDir": "src",
    "paths": {
      "svelte": ["./node_modules/svelte/types/runtime/index.d.ts"],
      "svelte/*": ["./node_modules/svelte/types/runtime/*/index.d.ts"],
      "*": ["./src/*"]
    },
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": false,
    "jsx": "react",
    "jsxFactory": "h",
    "noImplicitAny": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "esModuleInterop": true,
    "lib": ["dom", "scripthost", "ES2022"],
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["lib/**/*"]
}
